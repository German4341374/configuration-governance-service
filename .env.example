NODE_ENV=development
PORT=8080
LOG_LEVEL=info
AUTH_MODE=demo
POSTGRES_DB=governance
POSTGRES_USER=governance
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://governance:replace-with-a-local-password@postgres:5432/governance
CONFIG_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SIGNING_KEY=
MAX_UPLOAD_BYTES=262144
